<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: #2A2035;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.bingespice_app.CreateEditWatchlistScreen">

   <!-- Left Sidebar -->
   <left>
      <fx:include source="SideBar.fxml" />
   </left>

   <top>
      <fx:include source="TopBar.fxml" />
   </top>

   <!-- Main Content Area -->
   <center>
      <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #2C2D40;" vbarPolicy="NEVER">
         <VBox spacing="30" style="-fx-padding: 20; -fx-background-color: #2C2D40;">
            <!-- Search Bar -->
            <fx:include source="SearchBar.fxml" />
            <Label fx:id="modeLabel" contentDisplay="CENTER" text="Create New Watchlist" textFill="#fd6108">
               <font>
                  <Font size="35.0" />
               </font>
            </Label>
            <TextField fx:id="watchlistName" promptText="Enter Watchlsit name" />
            <HBox alignment="TOP_RIGHT" prefHeight="66.0">
               <children>
                  <StackPane alignment="TOP_CENTER" prefHeight="66.0" prefWidth="77.0">
                     <children>
                        <Button fx:id="confirmChangesButton" contentDisplay="CENTER" disable="true" mnemonicParsing="false" onAction="#handleConfirmChangesButton" style="-fx-background-color: #fd6108;" text="Confirm" visible="false" />
                        <Button fx:id="confirmButton" contentDisplay="CENTER" mnemonicParsing="false" onAction="#handleConfirmButton" prefHeight="31.0" prefWidth="77.0" style="-fx-background-color: #fd6108;" text="Confirm" />
                     </children>
                  </StackPane>
                  <Region prefHeight="66.0" prefWidth="125.0" />
                  <Button fx:id="deleteButton" alignment="TOP_RIGHT" disable="true" mnemonicParsing="false" onAction="#handleDeleteButton" style="-fx-background-color: #fd6108;" text="DELETE WATCHLIST" visible="false" />
               </children>
            </HBox>
            <HBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label fx:id="errorLabel" text="Label" textFill="RED" visible="false" />
               </children>
            </HBox>
         </VBox>
      </ScrollPane>
   </center>
</BorderPane>
